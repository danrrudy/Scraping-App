# Working data — patterns without a leading path apply at any depth.
data/
logs/
*.pdf
*.xlsx
*.log
user_settings.json
page_13.jpg
table_scraper_PIPELINE.py

# Python and test artifacts
__pycache__/
*.pyc
.pytest_cache/

# Crash dumps left behind by the shell
*.stackdump

# Build output
build/
dist/
*.spec.bak

# Plugin folders seeded into a source checkout at first run; the shipped
# copies live in bundled/. Anchored to the root so bundled/scrapers and
# bundled/extractors stay tracked.
/scrapers/
/extractors/

# Stray archives
*.zip
